# ── Database ─────────────────────────────────────────────────────────────────
# On Railway: provided automatically by the PostgreSQL plugin
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-this-to-a-random-32-plus-character-secret"
# Your public-facing app URL (used for auth redirects)
BETTER_AUTH_URL="https://your-app.up.railway.app"
# Same as BETTER_AUTH_URL in production (comma-separated, no trailing slash)
TRUSTED_ORIGINS="https://your-app.up.railway.app"

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="production"
# Railway injects PORT automatically — do not set this manually on Railway

# ── Inbound Email Webhook ─────────────────────────────────────────────────────
# Validated via X-Webhook-Secret header on POST /api/tickets/inbound
WEBHOOK_SECRET="change-this-to-a-random-secret"

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
# From https://console.groq.com — required for auto-resolve, classify, summarise, polish
GROQ_API_KEY=""

# ── Error Tracking (Sentry) — optional ───────────────────────────────────────
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"

# ── Seeding ───────────────────────────────────────────────────────────────────
# Used only when running prisma/seed.ts manually (Railway shell or one-off job)
SEED_ADMIN_EMAIL="admin@yourcompany.com"
